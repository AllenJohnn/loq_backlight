<ui:FluentWindow x:Class="LoqLighting.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:LoqLighting.App.ViewModels"
                 xmlns:models="clr-namespace:LoqLighting.App.Models"
                 Title="LOQ Lighting Studio"
                 Height="740" Width="940"
                 MinHeight="620" MinWidth="820"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="LOQ Lighting Studio" Grid.Row="0" Margin="-24,-24,-24,12" />

        <!-- Current Status Header -->
        <ui:Card Grid.Row="1" Margin="0,0,0,14" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Lightbulb24" FontSize="28" Margin="0,0,16,0" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock Text="Current Backlight: " FontTypography="Body" Appearance="Secondary" />
                            <ui:TextBlock Text="{Binding CurrentLevelText}" FontTypography="BodyStrong" />
                        </StackPanel>
                        <ui:TextBlock Text="{Binding HardwareDetailsText}" FontTypography="Caption" Appearance="Tertiary" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Content="Refresh"
                           Icon="{ui:SymbolIcon ArrowClockwise20}"
                           Command="{Binding RefreshCurrentStateCommand}"
                           VerticalAlignment="Center" />
            </Grid>
        </ui:Card>

        <!-- Fault Error Banner -->
        <Border Grid.Row="2" Background="#26E81123" BorderBrush="#88E81123" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14"
                Visibility="{Binding HasFaultError, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="DismissCircle24" FontSize="22" Foreground="#FFE81123" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:TextBlock Text="Hardware / Engine Fault" FontTypography="BodyStrong" Foreground="#FFE81123" />
                    <ui:TextBlock Text="{Binding FaultErrorMessage}" Appearance="Secondary" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button Grid.Column="2"
                           Icon="{ui:SymbolIcon Dismiss16}"
                           Command="{Binding DismissFaultBannerCommand}"
                           Appearance="Transparent"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Body: Effects List (Left) + Effect Controls (Right) -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Effects Column -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TextBlock Text="Stepped Effects (3-Level Hardware)"
                              FontTypography="Subtitle"
                              Margin="0,0,0,10" />

                <ListView Grid.Row="1"
                          ItemsSource="{Binding AvailableEffects}"
                          SelectedItem="{Binding SelectedEffect, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:EffectItem}">
                            <Border Padding="12,10" Margin="0,2">
                                <StackPanel>
                                    <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="{Binding Description}" Appearance="Secondary" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Controls Column -->
            <ui:Card Grid.Column="2" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Profiles Section -->
                        <StackPanel Margin="0,0,0,14">
                            <ui:TextBlock Text="Profiles" FontTypography="Subtitle" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          HorizontalAlignment="Stretch" />
                                <ui:Button Grid.Column="2"
                                           Icon="{ui:SymbolIcon Delete20}"
                                           Command="{Binding DeleteCurrentProfileCommand}"
                                           ToolTip="Delete selected profile"
                                           Appearance="Danger" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding ProfileNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Profile name..." />
                                <ui:Button Grid.Column="2"
                                           Content="Save"
                                           Icon="{ui:SymbolIcon Save20}"
                                           Command="{Binding SaveCurrentProfileCommand}" />
                            </Grid>
                        </StackPanel>

                        <Separator Margin="0,4,0,14" />

                        <!-- Startup & Automation Options -->
                        <StackPanel Margin="0,0,0,14">
                            <ui:TextBlock Text="Startup &amp; Automation" FontTypography="Subtitle" Margin="0,0,0,10" />
                            <CheckBox Content="Start with Windows (Task Scheduler, Admin)"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                      Margin="0,0,0,8" />
                            <CheckBox Content="Auto-start last profile on launch"
                                      IsChecked="{Binding AutoStartLastProfile, Mode=TwoWay}"
                                      Margin="0,0,0,4" />
                        </StackPanel>

                        <Separator Margin="0,4,0,14" />

                        <ui:TextBlock Text="Effect Controls" FontTypography="Subtitle" Margin="0,0,0,16" />

                        <!-- Speed Slider -->
                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <ui:TextBlock Text="Playback Speed" FontTypography="BodyStrong" />
                                <ui:TextBlock Text="{Binding SpeedDisplayText}" HorizontalAlignment="Right" Appearance="Secondary" />
                            </Grid>
                            <Slider Grid.Row="1"
                                    Minimum="0.25"
                                    Maximum="4.0"
                                    SmallChange="0.25"
                                    LargeChange="0.5"
                                    TickFrequency="0.25"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Speed, Mode=TwoWay}" />
                        </Grid>

                        <Separator Margin="0,4,0,14" />

                        <!-- Run Duration -->
                        <StackPanel Margin="0,0,0,14">
                            <ui:TextBlock Text="Run Duration" FontTypography="BodyStrong" Margin="0,0,0,6" />
                            <CheckBox Content="Infinite (runs until stopped)"
                                      IsChecked="{Binding IsInfiniteDuration, Mode=TwoWay}"
                                      Margin="0,0,0,8" />
                            <StackPanel Visibility="{Binding IsTimedDuration, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,6">
                                    <ui:TextBlock Text="Duration (seconds)" Appearance="Secondary" />
                                    <ui:TextBlock Text="{Binding RunDurationSeconds, StringFormat='{}{0} s'}" HorizontalAlignment="Right" Appearance="Secondary" />
                                </Grid>
                                <Slider Minimum="2"
                                        Maximum="120"
                                        SmallChange="1"
                                        LargeChange="5"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding RunDurationSeconds, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,4,0,14" />

                        <!-- Pause Duration (For Strobe with Pause) -->
                        <StackPanel Margin="0,0,0,14" IsEnabled="{Binding IsPauseDurationApplicable}">
                            <Grid Margin="0,0,0,6">
                                <ui:TextBlock Text="Pause Duration" FontTypography="BodyStrong" />
                                <ui:TextBlock Text="{Binding PauseDurationMs, StringFormat='{}{0} ms'}" HorizontalAlignment="Right" Appearance="Secondary" />
                            </Grid>
                            <Slider Minimum="100"
                                    Maximum="2000"
                                    SmallChange="50"
                                    LargeChange="100"
                                    TickFrequency="100"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding PauseDurationMs, Mode=TwoWay}" />
                            <ui:TextBlock Text="(Used by Strobe with pause)" Appearance="Tertiary" FontTypography="Caption" Margin="0,4,0,0" />
                        </StackPanel>

                        <Separator Margin="0,4,0,14" />

                        <!-- High and Low Level Pickers -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Text="High Level" FontTypography="BodyStrong" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding SupportedBrightnessLevels}"
                                          SelectedItem="{Binding SelectedHighLevel, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <ui:TextBlock Text="Low Level" FontTypography="BodyStrong" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding SupportedBrightnessLevels}"
                                          SelectedItem="{Binding SelectedLowLevel, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </Grid>

        <!-- Live Status Panel & Action Bar -->
        <ui:Card Grid.Row="4" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Live Status Metrics -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Engine State Badge -->
                    <Border CornerRadius="4" Padding="10,5" Margin="0,0,18,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{ui:ThemeResource ControlFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineStateText}" Value="Running">
                                        <Setter Property="Background" Value="#2233AA33" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineStateText}" Value="Faulted">
                                        <Setter Property="Background" Value="#33FF3333" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Circle24" FontSize="10" Margin="0,0,6,0">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EngineStateText}" Value="Running">
                                                <Setter Property="Foreground" Value="#55FF55" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EngineStateText}" Value="Faulted">
                                                <Setter Property="Foreground" Value="#FF5555" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <ui:TextBlock Text="{Binding EngineStateText}" FontTypography="BodyStrong" />
                        </StackPanel>
                    </Border>

                    <!-- Active Effect -->
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <ui:TextBlock Text="Current Effect" FontTypography="Caption" Appearance="Tertiary" />
                        <ui:TextBlock Text="{Binding ActiveEffectName}" FontTypography="BodyStrong" />
                    </StackPanel>

                    <!-- Elapsed Time -->
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <ui:TextBlock Text="Elapsed Time" FontTypography="Caption" Appearance="Tertiary" />
                        <ui:TextBlock Text="{Binding ElapsedTimeText}" FontTypography="BodyStrong" />
                    </StackPanel>

                    <!-- Last Error -->
                    <StackPanel VerticalAlignment="Center" MaxWidth="280" Visibility="{Binding HasLastError, Converter={StaticResource BoolToVis}}">
                        <ui:TextBlock Text="Last Error" FontTypography="Caption" Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}" />
                        <ui:TextBlock Text="{Binding LastErrorMessage}" FontTypography="Caption" Appearance="Secondary" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <!-- Start/Stop Action Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Primary"
                               Padding="20,10"
                               Command="{Binding TogglePlaybackCommand}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Content" Value="Start Effect" />
                                <Setter Property="Icon" Value="{ui:SymbolIcon Play24}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Content" Value="Stop Effect" />
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Stop24}" />
                                        <Setter Property="Appearance" Value="Danger" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
